      }
    },
    "Rules only hide. An item is hidden if any enabled rule matches it, and hidden items are left out of every count — they are listed under Filtered Items in the sidebar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln blenden nur aus. Ein Eintrag wird ausgeblendet, sobald eine aktive Regel zutrifft, und ausgeblendete Einträge werden nirgends mitgezählt – sie stehen in der Seitenleiste unter „Gefilterte Einträge“."
          }
        }
      }
    },
    "Running now": {
      "extractionState": "manual",
      "localizations": {
