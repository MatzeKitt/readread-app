    },
    "%@ has no usable server address.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keine nutzbare Serveradresse."
          }
        }
      }
    },
    "%@ has not allowed this yet. Use Reauthorise on its row in Settings to grant it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dies noch nicht erlaubt. In den Einstellungen „Neu autorisieren“ in der Zeile des Kontos verwenden, um die Berechtigung zu erteilen."
          }
        }
      }
    },
    "%@ is no longer authorised. Sign in to it again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht mehr autorisiert. Erneut anmelden."
